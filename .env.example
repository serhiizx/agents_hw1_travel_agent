# Конфігурація LLM-провайдера (OpenAI-сумісний endpoint).
# Використання:  cp .env.example .env   і розкоментувати потрібний варіант.
#
# ВАЖЛИВО: OPENAI_BASE_URL має закінчуватись на /v1.
# Без нього запит іде на POST /chat/completions і сервер відповідає
# "Unexpected endpoint or method".

# Варіант A: LM Studio (порт за замовчуванням 1234)
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
LLM_MODEL=google/gemma-4-e4b

# Варіант B: локальна модель через Ollama (ollama serve)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=gemma4

# Варіант C: проксі курсу
# OPENAI_BASE_URL=http://localhost:21128/v1
# OPENAI_API_KEY=sk-...
# LLM_MODEL=oc/deepseek-v4-flash-free

# Варіант D: справжній OpenAI
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
